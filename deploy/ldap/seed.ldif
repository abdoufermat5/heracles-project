dn: dc=heracles,dc=test
objectClass: top
objectClass: dcObject
objectClass: organization
objectClass: hrcAcl
dc: heracles
o: Heracles test directory
# ACL assignments (index:scope:base64(role DN):base64(members)):
#   0  admin        -> cn=admins,ou=groups  (alice)
#   1  self-service -> *                    (everyone, on their own entry)
hrcAclEntry: 0:subtree:Y249YWRtaW4sb3U9YWNscm9sZXMsZGM9aGVyYWNsZXMsZGM9dGVzdA==:Y249YWRtaW5zLG91PWdyb3VwcyxkYz1oZXJhY2xlcyxkYz10ZXN0
hrcAclEntry: 1:subtree:Y249c2VsZi1zZXJ2aWNlLG91PWFjbHJvbGVzLGRjPWhlcmFjbGVzLGRjPXRlc3Q=:Kg==

dn: ou=people,dc=heracles,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=heracles,dc=test
objectClass: organizationalUnit
ou: groups

dn: ou=dsa,dc=heracles,dc=test
objectClass: organizationalUnit
ou: dsa

dn: cn=heracles-service,ou=dsa,dc=heracles,dc=test
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: heracles-service
description: Heracles service account
userPassword: service-secret

dn: uid=alice,ou=people,dc=heracles,dc=test
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: alice
cn: Alice Martin
sn: Martin
givenName: Alice
mail: alice@heracles.test
userPassword: alice-secret

dn: uid=bob,ou=people,dc=heracles,dc=test
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: bob
cn: Bob Durand
sn: Durand
givenName: Bob
mail: bob@heracles.test
userPassword: bob-secret

dn: uid=carol,ou=people,dc=heracles,dc=test
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: carol
cn: Carol Petit
sn: Petit
givenName: Carol
mail: carol@heracles.test
userPassword: carol-secret

dn: cn=admins,ou=groups,dc=heracles,dc=test
objectClass: groupOfNames
cn: admins
member: uid=alice,ou=people,dc=heracles,dc=test

dn: cn=staff,ou=groups,dc=heracles,dc=test
objectClass: groupOfNames
cn: staff
member: uid=alice,ou=people,dc=heracles,dc=test
member: uid=bob,ou=people,dc=heracles,dc=test
member: uid=carol,ou=people,dc=heracles,dc=test

# POSIX group with the SMB mapping of the domain users group (SID + 513, seeded
# below). The dev SMB server uses it for the share's "valid users = @smbusers";
# enable a user's POSIX tab with gidNumber 2000 to make them a member.
dn: cn=smbusers,ou=groups,dc=heracles,dc=test
objectClass: posixGroup
objectClass: sambaGroupMapping
cn: smbusers
description: Members of the SMB share of the dev stack
gidNumber: 2000
sambaSID: S-1-5-21-2738473741-1357294590-3500904181-513
sambaGroupType: 2
memberUid: alice
memberUid: bob
memberUid: carol

# ACL roles, assigned on the base entry above. Self-service lets every user
# read their own entry and change a few personal fields.

dn: ou=aclroles,dc=heracles,dc=test
objectClass: organizationalUnit
ou: aclroles

dn: cn=admin,ou=aclroles,dc=heracles,dc=test
objectClass: hrcRole
cn: admin
description: Full rights on the whole directory
hrcAclTemplate: 0:all;cmdrw

dn: cn=self-service,ou=aclroles,dc=heracles,dc=test
objectClass: hrcRole
cn: self-service
description: Users read their own entry and update their contact details and password
hrcAclTemplate: 0:user/user;sr#telephoneNumber;srw#mobile;srw#jpegPhoto;srw#userPassword;srw

# DNS plugin: one forward zone and its reverse zone, served by the `dns`
# container of the dev stack (`dig @127.0.0.1 -p 15353 www.heracles.test`).

dn: ou=dns,dc=heracles,dc=test
objectClass: organizationalUnit
ou: dns

dn: zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: @
dNSTTL: 3600
sOARecord: ns1.heracles.test. hostmaster.heracles.test. 2026111101 3600 900 604800 3600
nSRecord: ns1.heracles.test.
mXRecord: 10 mail.heracles.test.
tXTRecord: v=spf1 -all

dn: relativeDomainName=ns1,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: ns1
aRecord: 10.0.0.2

dn: relativeDomainName=www,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: www
aRecord: 10.0.0.10

dn: relativeDomainName=mail,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: mail
aRecord: 10.0.0.20

dn: relativeDomainName=alias,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: alias
cNAMERecord: www.heracles.test.

dn: zoneName=2.0.192.in-addr.arpa,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: 2.0.192.in-addr.arpa
relativeDomainName: @
dNSTTL: 3600
sOARecord: ns1.heracles.test. hostmaster.heracles.test. 2026111101 3600 900 604800 3600
nSRecord: ns1.heracles.test.

dn: relativeDomainName=10,zoneName=2.0.192.in-addr.arpa,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: 2.0.192.in-addr.arpa
relativeDomainName: 10
pTRRecord: www.heracles.test.

# SMB plugin: the domain entry the SMB server and the plugin read (its SID,
# policy and RID counters). The dev SMB container also creates this entry when
# it is missing (deploy/dev/smb/entrypoint.sh) with the same SID.
# The staff group maps to the domain users group so the share's "valid users = @staff"
# resolves through the directory; users get the same gidNumber as their primary group.

dn: sambaDomainName=HERACLES,dc=heracles,dc=test
objectClass: top
objectClass: sambaDomain
sambaDomainName: HERACLES
sambaSID: S-1-5-21-2738473741-1357294590-3500904181
sambaAlgorithmicRidBase: 1000
sambaNextRid: 1000
sambaNextUserRid: 1000
sambaNextGroupRid: 1001
sambaMinPwdLength: 5
sambaPwdHistoryLength: 0
sambaLogonToChgPwd: 0
sambaMaxPwdAge: -1
sambaMinPwdAge: 0
sambaLockoutDuration: 30
sambaLockoutObservationWindow: 30
sambaLockoutThreshold: 0
sambaForceLogoff: -1
sambaRefuseMachinePwdChange: 0

# DHCP plugin: the service entry the DHCP container renders into dhcpd.conf, on
# the isolated compose network 192.168.220.0/24 (deploy/docker-compose.yml).
# The test client (same MAC) gets the fixed address from the host entry below.

dn: ou=dhcp,dc=heracles,dc=test
objectClass: organizationalUnit
ou: dhcp

dn: cn=dev-dhcp,ou=dhcp,dc=heracles,dc=test
objectClass: top
objectClass: dhcpService
cn: dev-dhcp
dhcpStatements: authoritative
dhcpStatements: default-lease-time 600
dhcpStatements: max-lease-time 7200
dhcpOption: domain-name "heracles.test"

dn: cn=192.168.220.0,cn=dev-dhcp,ou=dhcp,dc=heracles,dc=test
objectClass: top
objectClass: dhcpSubnet
cn: 192.168.220.0
dhcpNetMask: 24
dhcpRange: 192.168.220.100 192.168.220.199
dhcpOption: routers 192.168.220.1
dhcpOption: domain-name-servers 192.168.220.1

dn: cn=dhcp-client,cn=192.168.220.0,cn=dev-dhcp,ou=dhcp,dc=heracles,dc=test
objectClass: top
objectClass: dhcpHost
cn: dhcp-client
dhcpHWAddress: ethernet 52:54:00:fe:dc:01
dhcpStatements: fixed-address 192.168.220.50
