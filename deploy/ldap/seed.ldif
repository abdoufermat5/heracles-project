dn: dc=heracles,dc=test
objectClass: top
objectClass: dcObject
objectClass: organization
dc: heracles
o: Heracles test directory

dn: ou=people,dc=heracles,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=heracles,dc=test
objectClass: organizationalUnit
ou: groups

dn: ou=dsa,dc=heracles,dc=test
objectClass: organizationalUnit
ou: dsa

dn: cn=heracles-service,ou=dsa,dc=heracles,dc=test
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: heracles-service
description: Heracles service account
userPassword: service-secret

dn: uid=alice,ou=people,dc=heracles,dc=test
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: alice
cn: Alice Martin
sn: Martin
givenName: Alice
mail: alice@heracles.test
userPassword: alice-secret

dn: uid=bob,ou=people,dc=heracles,dc=test
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: bob
cn: Bob Durand
sn: Durand
givenName: Bob
mail: bob@heracles.test
userPassword: bob-secret

dn: uid=carol,ou=people,dc=heracles,dc=test
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
uid: carol
cn: Carol Petit
sn: Petit
givenName: Carol
mail: carol@heracles.test
userPassword: carol-secret

dn: cn=admins,ou=groups,dc=heracles,dc=test
objectClass: groupOfNames
cn: admins
member: uid=alice,ou=people,dc=heracles,dc=test

dn: cn=staff,ou=groups,dc=heracles,dc=test
objectClass: groupOfNames
cn: staff
member: uid=alice,ou=people,dc=heracles,dc=test
member: uid=bob,ou=people,dc=heracles,dc=test
member: uid=carol,ou=people,dc=heracles,dc=test

# DNS plugin: one forward zone and its reverse zone, served by the `dns`
# container of the dev stack (`dig @127.0.0.1 -p 15353 www.heracles.test`).

dn: ou=dns,dc=heracles,dc=test
objectClass: organizationalUnit
ou: dns

dn: zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: @
dNSTTL: 3600
sOARecord: ns1.heracles.test. hostmaster.heracles.test. 2026111101 3600 900 604800 3600
nSRecord: ns1.heracles.test.
mXRecord: 10 mail.heracles.test.
tXTRecord: v=spf1 -all

dn: relativeDomainName=ns1,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: ns1
aRecord: 10.0.0.2

dn: relativeDomainName=www,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: www
aRecord: 10.0.0.10

dn: relativeDomainName=mail,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: mail
aRecord: 10.0.0.20

dn: relativeDomainName=alias,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: heracles.test
relativeDomainName: alias
cNAMERecord: www.heracles.test.

dn: zoneName=2.0.192.in-addr.arpa,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: 2.0.192.in-addr.arpa
relativeDomainName: @
dNSTTL: 3600
sOARecord: ns1.heracles.test. hostmaster.heracles.test. 2026111101 3600 900 604800 3600
nSRecord: ns1.heracles.test.

dn: relativeDomainName=10,zoneName=2.0.192.in-addr.arpa,zoneName=heracles.test,ou=dns,dc=heracles,dc=test
objectClass: top
objectClass: dNSZone
zoneName: 2.0.192.in-addr.arpa
relativeDomainName: 10
pTRRecord: www.heracles.test.
